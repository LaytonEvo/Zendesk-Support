# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- Zendesk ---------------------------------------------------------------
# Admin Center -> Apps and integrations -> Zendesk API -> Settings -> Add API token
ZENDESK_SUBDOMAIN=evolutiongolf
ZENDESK_EMAIL=you@evolutiongolf.co.uk
ZENDESK_API_TOKEN=

# --- Anthropic (draft generation, phase 3) ---------------------------------
ANTHROPIC_API_KEY=

# --- Shopify (live order lookup for drafts) --------------------------------
# Dev Dashboard -> your app -> Client ID and Client secret.
# The app and the store must be in the SAME Shopify organization, or the grant
# fails with shop_not_permitted.
#
# Scopes are set on the app's VERSION in the Dev Dashboard, not in the request.
# Needed: read_orders, read_customers, read_returns - and read_all_orders,
# without which lookups silently return nothing for orders older than 60 days.
SHOPIFY_STORE_DOMAIN=evolutiongolf.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Only for an older admin-created app with a permanent shpat_ token. Those
# apps can no longer be created; leave this blank and use the client
# credentials above. If set, it takes precedence.
SHOPIFY_ACCESS_TOKEN=

# Pinned so a Shopify version bump cannot change behaviour unnoticed.
SHOPIFY_API_VERSION=2026-07

# --- Proactive delay sweep -------------------------------------------------
# Finds orders the customer has NOT written in about but should hear from us
# (rule 9). Raises a Zendesk ticket carrying a drafted message as an INTERNAL
# note. Nothing is sent to a customer.
#
# Leave this false until you have checked Admin Center -> Objects and rules ->
# Triggers. A ticket created WITH a requester can fire this account's own
# notification triggers and email the customer before anyone has read the
# draft, which is the opposite of what this is for.
PROACTIVE_SET_REQUESTER=false

# Optional: morning digest of what the sweep found.
SLACK_WEBHOOK_URL=

# --- Local corpus ----------------------------------------------------------
CORPUS_DB=data/corpus.sqlite3

# Redact customer PII (emails, phones, postcodes) as comments are stored.
# Strongly recommended: keep this on unless you have a specific reason not to.
REDACT_PII=true
