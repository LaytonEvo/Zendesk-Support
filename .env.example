# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- Zendesk ---------------------------------------------------------------
# Admin Center -> Apps and integrations -> Zendesk API -> Settings -> Add API token
ZENDESK_SUBDOMAIN=evolutiongolf
ZENDESK_EMAIL=you@evolutiongolf.co.uk
ZENDESK_API_TOKEN=

# --- Anthropic (draft generation, phase 3) ---------------------------------
ANTHROPIC_API_KEY=

# --- Shopify (live order lookup for drafts) --------------------------------
# Shopify admin -> Settings -> Apps and sales channels -> Develop apps ->
# create an app -> Admin API access token.
# Scopes needed: read_orders, read_customers, read_returns.
# IMPORTANT: read_orders alone only reaches the last 60 DAYS of orders. Warranty
# and returns tickets routinely reference older orders, so request the
# read_all_orders scope too or those lookups silently return nothing.
SHOPIFY_STORE_DOMAIN=evolutiongolf.myshopify.com
SHOPIFY_ACCESS_TOKEN=
# Pinned so a Shopify version bump cannot change behaviour unnoticed.
SHOPIFY_API_VERSION=2026-07

# --- Local corpus ----------------------------------------------------------
CORPUS_DB=data/corpus.sqlite3

# Redact customer PII (emails, phones, postcodes) as comments are stored.
# Strongly recommended: keep this on unless you have a specific reason not to.
REDACT_PII=true
